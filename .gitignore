```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Backup directories
data_feed_backup_old/

# Environment files
.env
.env.local
*.env.*

# Logs
*.log

# Coverage reports
coverage/
htmlcov/
.coverage

# IDE specific
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS generated files
.DS_Store
Thumbs.db
```